{
    "name": "MathTrail LLM TaskGen Prototype DevContainer",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2.17.0": {}
    },
    "mounts": [
        "source=llm-taskgen-prototype-claude,target=/home/vscode/.claude,type=volume"
    ],
    "containerEnv": {
        "UV_LINK_MODE": "copy",
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
        "DISABLE_AUTOUPDATER": "1"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
                "python.testing.pytestEnabled": true,
                "python.testing.pytestArgs": ["tests"],
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff"
                }
            },
            "extensions": [
                "anthropic.claude-code@2.1.270",
                "ms-python.python@2026.4.0",
                "ms-python.vscode-pylance@2026.3.1",
                "charliermarsh.ruff@2026.80.0",
                "tamasfe.even-better-toml@0.21.2",
                "redhat.vscode-yaml@1.24.0",
                "ms-azuretools.vscode-containers@2.5.0",
                "ms-ossdata.vscode-pgsql@1.30.1",
                "bierner.markdown-mermaid@1.32.1",
                "eamodio.gitlens@19.1.0"
            ]
        }
    },
    "postCreateCommand": "uv sync"
}
